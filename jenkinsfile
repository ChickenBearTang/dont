pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    tools {
        jdk 'jdk21'
        nodejs 'node20'
    }

    environment {
        DEV_BRANCH = 'dev'
        PROD_BRANCH = 'main'

        APP_NAME = 'awesome-spring-project'
        BACKEND_DIR = 'backend'
        FRONTEND_DIR = 'frontend'
        RELEASE_DIR = 'release_out'

        MAIN_SERVER_HOST = ''
        MAIN_SERVER_USER = 'deploy'
        AI_SERVER_HOST = ''
        AI_SERVER_USER = 'deploy'
        AI_PRIVATE_HEALTH_URL = 'http://127.0.0.1:8000/health/readyz'

        EDGE_BASE_URL = ''
        EDGE_FRONTEND_PATH = '/'
        EDGE_HEALTH_PATH = '/actuator/health'
        EDGE_AI_SAMPLE_PATH = '/api/health/ai'

        MAIN_DEPLOY_ROOT = '/opt/awesome-spring-project'
        BACKEND_SERVICE_NAME = 'spring-backend'
        FRONTEND_SERVICE_NAME = 'frontend-node'

        DEPLOY_SSH_CREDENTIALS_ID = ''
        AUTO_ROLLBACK_ON_MAIN = 'true'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Metadata') {
            steps {
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.RELEASE_ID = "${env.GIT_SHA}-${env.BUILD_NUMBER}"
                    env.RELEASE_MANIFEST = "${env.RELEASE_DIR}/manifest-${env.RELEASE_ID}.json"
                }
            }
        }

        stage('Build and Test') {
            parallel {
                stage('Frontend') {
                    steps {
                        sh 'bash ci/build_frontend.sh'
                    }
                }
                stage('Backend') {
                    steps {
                        sh 'bash ci/build_backend.sh'
                    }
                }
            }
        }

        stage('Package Release') {
            steps {
                sh 'bash ci/package_release.sh'
            }
        }

        stage('Non-Main Branch Stop Gate') {
            when {
                expression { env.BRANCH_NAME != env.PROD_BRANCH }
            }
            steps {
                echo 'Non-main branch: build/verify only. Deployment skipped by policy.'
            }
        }

        stage('Validate Main Deploy Config') {
            when {
                expression { env.BRANCH_NAME == env.PROD_BRANCH }
            }
            steps {
                script {
                    def required = [
                        env.MAIN_SERVER_HOST,
                        env.MAIN_SERVER_USER,
                        env.EDGE_BASE_URL,
                        env.DEPLOY_SSH_CREDENTIALS_ID
                    ]
                    if (required.any { it == null || it.trim().isEmpty() }) {
                        error('MAIN deploy variables are missing. Set MAIN_SERVER_HOST, MAIN_SERVER_USER, EDGE_BASE_URL, DEPLOY_SSH_CREDENTIALS_ID.')
                    }
                }
            }
        }

        stage('Deploy Main - Backend') {
            when {
                expression { env.BRANCH_NAME == env.PROD_BRANCH }
            }
            steps {
                sshagent(credentials: ["${env.DEPLOY_SSH_CREDENTIALS_ID}"]) {
                    sh '''
                        bash ci/deploy_remote.sh \
                          --host "${MAIN_SERVER_HOST}" \
                          --user "${MAIN_SERVER_USER}" \
                          --component backend \
                          --release-id "${RELEASE_ID}" \
                          --archive "${RELEASE_DIR}/backend-${RELEASE_ID}.tgz" \
                          --service "${BACKEND_SERVICE_NAME}" \
                          --deploy-root "${MAIN_DEPLOY_ROOT}" \
                          --ready-url "http://127.0.0.1:8080/actuator/health"
                    '''
                }
            }
        }

        stage('Deploy Main - Frontend') {
            when {
                expression { env.BRANCH_NAME == env.PROD_BRANCH }
            }
            steps {
                sshagent(credentials: ["${env.DEPLOY_SSH_CREDENTIALS_ID}"]) {
                    sh '''
                        bash ci/deploy_remote.sh \
                          --host "${MAIN_SERVER_HOST}" \
                          --user "${MAIN_SERVER_USER}" \
                          --component frontend \
                          --release-id "${RELEASE_ID}" \
                          --archive "${RELEASE_DIR}/frontend-${RELEASE_ID}.tgz" \
                          --service "${FRONTEND_SERVICE_NAME}" \
                          --deploy-root "${MAIN_DEPLOY_ROOT}" \
                          --ready-url "http://127.0.0.1:3000"
                    '''
                }
            }
        }

        stage('Verify Edge and AI Connectivity') {
            when {
                expression { env.BRANCH_NAME == env.PROD_BRANCH }
            }
            steps {
                sshagent(credentials: ["${env.DEPLOY_SSH_CREDENTIALS_ID}"]) {
                    sh '''
                        bash ci/verify_edge.sh \
                          --base-url "${EDGE_BASE_URL}" \
                          --frontend-path "${EDGE_FRONTEND_PATH}" \
                          --health-path "${EDGE_HEALTH_PATH}" \
                          --ai-sample-path "${EDGE_AI_SAMPLE_PATH}"

                        if [ -n "${AI_SERVER_HOST}" ]; then
                          ssh -o StrictHostKeyChecking=accept-new "${MAIN_SERVER_USER}@${MAIN_SERVER_HOST}" \
                            "curl -fsS '${AI_PRIVATE_HEALTH_URL}' > /dev/null"
                        fi
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'release_out/**, frontend/dist/**, backend/build/libs/**', onlyIfSuccessful: false
            junit allowEmptyResults: true, testResults: 'backend/build/test-results/test/*.xml'
        }
        failure {
            script {
                if (env.BRANCH_NAME == env.PROD_BRANCH && env.AUTO_ROLLBACK_ON_MAIN == 'true' && env.MAIN_SERVER_HOST?.trim()) {
                    echo 'Main deployment failed. Attempting rollback on backend/frontend.'
                    sshagent(credentials: ["${env.DEPLOY_SSH_CREDENTIALS_ID}"]) {
                        sh '''
                            bash ci/rollback_remote.sh \
                              --host "${MAIN_SERVER_HOST}" \
                              --user "${MAIN_SERVER_USER}" \
                              --component backend \
                              --service "${BACKEND_SERVICE_NAME}" \
                              --deploy-root "${MAIN_DEPLOY_ROOT}" || true

                            bash ci/rollback_remote.sh \
                              --host "${MAIN_SERVER_HOST}" \
                              --user "${MAIN_SERVER_USER}" \
                              --component frontend \
                              --service "${FRONTEND_SERVICE_NAME}" \
                              --deploy-root "${MAIN_DEPLOY_ROOT}" || true
                        '''
                    }
                } else {
                    echo 'Failure detected. Auto-rollback skipped by policy (non-main or disabled).'
                }
                sh 'bash ci/collect_diagnostics.sh || true'
            }
        }
        cleanup {
            cleanWs(cleanWhenNotBuilt: false, deleteDirs: true, disableDeferredWipeout: true)
        }
    }
}
